# ─── Configuration du Bot WhatsApp ───────────────────────────────────────────
BOT_NAME=Unified Bot
OWNER_NUMBER=1234567890@s.whatsapp.net
PREFIX=.

# ─── Connexion via Pairing Code (remplace le QR code) ────────────────────────
# Entrez votre numéro WhatsApp au format international sans le +
# Exemple : 212612345678 (Maroc) | 33612345678 (France) | 221771234567 (Sénégal)
# Si laissé vide, le bot vous le demandera au démarrage dans le terminal.
PHONE_NUMBER=

# ─── Clés API (optionnelles pour les fonctionnalités avancées) ────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=

# ─── Mode du Bot ─────────────────────────────────────────────────────────────
# true  = tout le monde peut utiliser le bot
# false = uniquement le propriétaire
PUBLIC_MODE=true

# ─── Stockage de session ──────────────────────────────────────────────────────
SESSION_DIR=./session
